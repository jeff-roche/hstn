[Unit]
Description=HSTN InputPlumber HID isolation guard
Requires=inputplumber.service
After=inputplumber.service
PartOf=inputplumber.service
Before=graphical.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /usr/local/libexec/session-switch-input-guard.py
User=root
RuntimeDirectory=session-switch-input-guard
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=110
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target inputplumber.service
